      "Bash(uv run --directory pipeline python -m erdata.fetch:*)",
      "Bash(uv run --directory pipeline python -m erdata.compile_protos:*)",
      "Bash(uv run --directory pipeline python -m erdata.refresh_check:*)",
      "Bash(uv sync --directory pipeline:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run build:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run sync-data:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)"
    ]
  }
